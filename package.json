{
  "name": "convite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d && docker compose exec -T db bash -c 'until pg_isready -U convite -d convite; do sleep 1; done'",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && pnpm db:migrate && pnpm sembrar:territorio && pnpm db:seed",
    "emparejar": "tsx scripts/emparejar.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit generate --name drift_check",
    "invitar": "tsx scripts/invitar.ts",
    "drill:respaldo": "bash scripts/drill-respaldo.sh",
    "worker": "tsx scripts/worker.ts",
    "vista:mapa": "tsx scripts/vista-mapa.ts",
    "vista:bandeja": "tsx --tsconfig tsconfig.scripts.json scripts/vista-bandeja.tsx",
    "vista:manifiesto": "tsx --tsconfig tsconfig.scripts.json scripts/vista-manifiesto.tsx",
    "build:limpio": "env -u DATABASE_URL -u BETTER_AUTH_SECRET -u BETTER_AUTH_URL -u RESEND_API_KEY next build",
    "sembrar:staff": "tsx scripts/sembrar-staff.ts",
    "sembrar:plataforma": "tsx scripts/sembrar-plataforma.ts",
    "sembrar:territorio": "tsx scripts/sembrar-territorio.ts"
  },
  "dependencies": {
    "better-auth": "1.6.29",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.3.0",
    "next": "^15.3.3",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^20.17.50",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
