# Copy to .env and fill in. Never commit .env.
# Local default matches docker-compose.yml.
DATABASE_URL=postgresql://convite:convite@localhost:5433/convite

# ⚠️  Los que el código lee de verdad son los NEXT_PUBLIC_. El middleware corre en cada
# petición y construye el cliente con ellos: si faltan, TODAS las rutas devuelven 500,
# incluidas /api/salud y el webhook. Descubierto en el ensayo de despliegue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Estos los valida lib/env.ts y hoy no los lee nadie más. Se dejan por compatibilidad.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API — supplied by the PARTNER ORGANISATION whose WABA we operate under.
# These are per-organisation values; they are mirrored into `organizaciones` so a second
# partner can be onboarded without a deploy. The token and app secret stay in env.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Google Maps Platform
# Server key: IP-restricted, never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: HTTP-referrer-restricted.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Transcription
OPENAI_API_KEY=

APP_BASE_URL=http://localhost:3000

# Where downloaded media is written. Operational data lives outside the repo;
# defaults to ./.data when unset. Never a provider URL — see non-negotiable 2.6.
DATA_DIR=
