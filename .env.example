# Copy to .env and fill in. Never commit .env.
# Local default matches docker-compose.yml.
DATABASE_URL=postgresql://convite:convite@localhost:5433/convite

# ── Identidad ────────────────────────────────────────────────────────────────────────────
# La identidad vive en ESTA base de datos (migración 0028). No hay un segundo servicio que
# levantar: con DATABASE_URL y el secreto de abajo, el panel entra.
#
# Firma la cookie de sesión. Sin él el panel responde 503 y dice cuál falta. No tiene valor
# por defecto a propósito: un secreto compartido y conocido deja que cualquiera se fabrique
# una sesión con el correo que quiera.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Origen público donde responden las rutas de autenticación. Si se omite se usa
# APP_BASE_URL, que es lo correcto aquí: el panel y /api/auth son el mismo servidor.
BETTER_AUTH_URL=

# ── Correo ───────────────────────────────────────────────────────────────────────────────
# Manda el enlace de ingreso. Si falta, el enlace se imprime en la consola del servidor en
# vez de enviarse: un clon nuevo puede entrar sin credenciales de ningún proveedor.
RESEND_API_KEY=
# Tiene que ser un dominio VERIFICADO en Resend. Uno sin verificar no falla suave: son 422
# en cada envío. Nunca el dominio raíz. Por defecto: Convite <no-responder@dev.downshiftit.com>
EMAIL_FROM=

# WhatsApp Cloud API — supplied by the PARTNER ORGANISATION whose WABA we operate under.
# These are per-organisation values; they are mirrored into `organizaciones` so a second
# partner can be onboarded without a deploy. The token and app secret stay in env.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Infobip — voice + SMS (PRD-15, PRD v3 §4.1.6). Absent, both channels run on their
# simulators, same as WhatsApp above.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_VOICE_NUMBER=
INFOBIP_VOICE_APPLICATION_ID=
INFOBIP_VOICE_CALLS_CONFIG_ID=
INFOBIP_VOICE_ANUNCIO_PREVIO=
INFOBIP_SMS_SENDER=
INFOBIP_WEBHOOK_SECRET=

# Google Maps Platform
# Server key: IP-restricted, never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: HTTP-referrer-restricted.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Transcription
OPENAI_API_KEY=

APP_BASE_URL=http://localhost:3000

# Where downloaded media is written. Operational data lives outside the repo;
# defaults to ./.data when unset. Never a provider URL — see non-negotiable 2.6.
DATA_DIR=

# Mapa sin conexión (PRD-13 / §26). Ruta pública desde donde se sirve el archivo PMTiles del
# territorio, p. ej. /mapa/choco.pmtiles. Vacío: el mapa usa las teselas OSM en línea y no hay
# basemap sin conexión. Construye el paquete con `bash scripts/construir-pmtiles.sh` (extracto
# libre de OSM/Protomaps, sin llave) y colócalo en public/mapa/ antes de fijar esta variable.
# El .pmtiles NO se versiona (es dato operativo); ver docs/mapas-offline.md.
NEXT_PUBLIC_PMTILES_URL=
